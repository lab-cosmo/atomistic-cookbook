# RESTART   (uncomment to continue a run from the existing HILLS file)

cv: METATOMIC ...
    MODEL=cv.pt
    DEVICE=cuda
    EXTENSIONS_DIRECTORY=extensions
    SPECIES1={1 2 3 4 9 12 15 18 21 24 27 30 33 36 39 42 45 48 51 54 57 60 63 66 69 72 75 78 81 84 87 90 93 96 99 102 105 108 111 114 117 120 123 126 129 132 135 138 141 144 147 150 153 156 159 162 165 168 171 174 177 180 183 186 189 192 195 198 201 204 207 210 213 216 219 222 225 228 231 234 237 240 243 246 249 252 255 258 261 264 267 270 273 276 279 282 285 288 291 294 297 300 303 306 309 312 315 318 321 324 327 330 333 336 339 342 345 348 351 354 357 360 363 366 369 372 375 378 381 384 387 390}
    SPECIES2={5 6 7 10 13 14 16 17 19 20 22 23 25 26 28 29 31 32 34 35 37 38 40 41 43 44 46 47 49 50 52 53 55 56 58 59 61 62 64 65 67 68 70 71 73 74 76 77 79 80 82 83 85 86 88 89 91 92 94 95 97 98 100 101 103 104 106 107 109 110 112 113 115 116 118 119 121 122 124 125 127 128 130 131 133 134 136 137 139 140 142 143 145 146 148 149 151 152 154 155 157 158 160 161 163 164 166 167 169 170 172 173 175 176 178 179 181 182 184 185 187 188 190 191 193 194 196 197 199 200 202 203 205 206 208 209 211 212 214 215 217 218 220 221 223 224 226 227 229 230 232 233 235 236 238 239 241 242 244 245 247 248 250 251 253 254 256 257 259 260 262 263 265 266 268 269 271 272 274 275 277 278 280 281 283 284 286 287 289 290 292 293 295 296 298 299 301 302 304 305 307 308 310 311 313 314 316 317 319 320 322 323 325 326 328 329 331 332 334 335 337 338 340 341 343 344 346 347 349 350 352 353 355 356 358 359 361 362 364 365 367 368 370 371 373 374 376 377 379 380 382 383 385 386 388 389 391 392}
    SPECIES3=8
    SPECIES4={11}
    SPECIES_TO_TYPES=8,1,15,11
...

r: SELECT_COMPONENTS ARG=cv COMPONENTS=1
q: SELECT_COMPONENTS ARG=cv COMPONENTS=2
ssc: SELECT_COMPONENTS ARG=cv COMPONENTS=3

not_dissociated: BETWEEN LOWER=-1.05 UPPER=-0.98 ARG=q
screened_ssc: PRODUCT ARG=ssc,not_dissociated

sw: UPPER_WALLS ARG=screened_ssc AT=0.005 KAPPA=500.0 EXP=1.0
wider_sw: UPPER_WALLS ARG=ssc AT=0.15 KAPPA=200.0 EXP=1.0
up: UPPER_WALLS ARG=r AT=14 KAPPA=1.0
lo: LOWER_WALLS ARG=r AT=-14 KAPPA=1.0

METAD ...
    ARG=r
    SIGMA=0.3
    HEIGHT=2.494*0.8 # 0.8 kT (in kJ/mol)
    PACE=1000 # one hill every 0.5 ps
    BIASFACTOR=8
    TEMP=300
    LABEL=metad
    GRID_MIN=-20.0
    GRID_MAX=20.0
    GRID_BIN=800
    CALC_RCT
    FILE=./HILLS
...
PRINT ARG=r,q,ssc,metad.bias,screened_ssc,sw.bias,up.bias,lo.bias FILE=COLVAR
