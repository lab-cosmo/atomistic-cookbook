<simulation verbosity='low'>
  <output prefix='pimd'>
    <!-- kinetic_cv is the centroid-virial estimator of the quantum kinetic energy -->
    <properties stride='1' filename='out'> [ step, time{picosecond}, conserved{electronvolt},
      temperature{kelvin}, kinetic_cv{electronvolt}, potential{electronvolt},
      pressure_cv{bar}, density{g/cm3}, kinetic_td{electronvolt} ] </properties>
    <trajectory filename='pos' stride='100' format='ase' bead='0'> positions </trajectory>
    <trajectory filename='colvar' stride='1' bead='0' extra_type='D'> extras_bias </trajectory>
  </output>
  <total_steps> 1000000 </total_steps>
  <prng> <seed> __SEED__ </seed> </prng>
  <!-- all beads are evaluated in a single batched call to the model -->
  <ffdirect name='mlip' threaded='True'>
    <pes> metatomic </pes>
    <parameters> { template: __STRUCTURE__, model: __MODEL__, device: cpu } </parameters>
    <batch_size> __NBEADS__ </batch_size>
  </ffdirect>
  <ffplumed name='plumed'>
    <file mode='ase'> __STRUCTURE__ </file>
    <plumed_dat> __PLUMED__ </plumed_dat>
    <plumed_extras> [ D ] </plumed_extras>
  </ffplumed>
  <system>
    <initialize nbeads='__NBEADS__'>
      <file mode='ase'> __STRUCTURE__ </file>
      <!-- masses scaled by 1/y^2 for the mass thermodynamic integration -->
      <masses mode='manual' units='dalton'> __MASSES__ </masses>
      <velocities mode='thermal' units='kelvin'> 300 </velocities>
    </initialize>
    <forces> <force forcefield='mlip'/> </forces>
    <ensemble>
      <temperature units='kelvin'> 300 </temperature>
      <pressure units='bar'> 1.0 </pressure>
      <!-- the restraint acts on the centroid only -->
      <bias>
        <force forcefield='plumed' nbeads='1'>
          <interpolate_extras> [ D ] </interpolate_extras>
        </force>
      </bias>
    </ensemble>
    <motion mode='dynamics'>
      <dynamics mode='npt'>
        <timestep units='femtosecond'> 0.5 </timestep>
        <thermostat mode='pile_l'> <tau units='femtosecond'> 20 </tau> </thermostat>
        <barostat mode='isotropic'>
          <tau units='femtosecond'> 100 </tau>
          <thermostat mode='svr'> <tau units='femtosecond'> 100 </tau> </thermostat>
        </barostat>
      </dynamics>
    </motion>
  </system>
</simulation>
